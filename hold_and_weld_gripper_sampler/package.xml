<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hold_and_weld_gripper_sampler</name>
  <version>0.3.0</version>
  <description>
    Constraint-aware grasp sampling library using OpenCASCADE topology extraction.
    Provides geometric analysis and filtering for robotic gripper planning.
  </description>

  <maintainer email="berkantali23@outlook.com">Berkan Tali</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>tinyxml2</depend>
  <depend>embree</depend>
  <depend>libfcl-dev</depend>
  <!-- OpenCASCADE 7.9.3 is built from source (see the top-level README); there is
       no rosdep key for it and apt only ships 7.6. -->
  <!-- The example configs load workpieces from the description package's .urdf.xacro files. -->
  <exec_depend>hold_and_weld_description</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
