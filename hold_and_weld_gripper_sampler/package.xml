<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hold_and_weld_gripper_sampler</name>
  <version>0.2.0</version>
  <description>
    Plugin-based grasp sampling library using OpenCASCADE topology extraction.
    Provides geometric analysis and filtering for robotic gripper planning.
  </description>

  <maintainer email="berkantali23@outlook.com">Berkan Tali</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>tinyxml2</depend>
  <!-- Embree 4: no standard rosdep key exists. Install manually:
       Ubuntu: sudo apt install libembree-dev  (or build from source for Embree 4)
       The CMakeLists.txt uses find_package(embree 4.0 REQUIRED) -->
  <depend>libembree-dev</depend>
  <depend>fcl</depend>
  <depend>opencascade</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
