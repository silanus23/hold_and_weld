# MoveToPose.action
# Action for moving robot to a target position in joint or Cartesian space

# Goal
int32 JOINT_SPACE = 0
int32 CARTESIAN_SPACE = 1

int32 mode
string[] joint_names
float64[] joint_positions
geometry_msgs/Pose cartesian_target
string move_group_name
---
# Result
bool success
string message
float64 execution_time_sec
---
# Feedback
string current_step
float32 completion_percentage
