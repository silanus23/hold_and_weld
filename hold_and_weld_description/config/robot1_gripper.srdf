<?xml version="1.0" encoding="UTF-8"?>
<robot name="gripper_system">
  <!-- Robot 1: Gripper System -->
  <group name="robot1_arm">
    <joint name="robot1_rail_joint"/>
    <joint name="robot1_joint_1"/>
    <joint name="robot1_joint_2"/>
    <joint name="robot1_joint_3"/>
    <joint name="robot1_joint_4"/>
    <joint name="robot1_joint_5"/>
    <joint name="robot1_joint_6"/>
  </group>

  <group name="robot1_gripper">
    <joint name="robot1_left_finger_joint"/>
    <joint name="robot1_right_finger_joint"/>
  </group>

  <!-- Virtual joint -->
  <virtual_joint name="robot1_virtual_joint" type="fixed" parent_frame="world" child_link="robot1_rail_base"/>

  <!-- Collision pairs -->
  <disable_collisions link1="robot1_rail_base" link2="robot1_rail_carriage" reason="Adjacent"/>
  <disable_collisions link1="robot1_rail_carriage" link2="robot1_base_link" reason="Adjacent"/>
  <disable_collisions link1="robot1_rail_base" link2="robot1_base_link" reason="User"/>
  <disable_collisions link1="robot1_base_link" link2="robot1_link_1" reason="Adjacent"/>
  <disable_collisions link1="robot1_link_1" link2="robot1_link_2" reason="Adjacent"/>
  <disable_collisions link1="robot1_link_2" link2="robot1_link_3" reason="Adjacent"/>
  <disable_collisions link1="robot1_link_3" link2="robot1_link_4" reason="Adjacent"/>
  <disable_collisions link1="robot1_link_4" link2="robot1_link_5" reason="Adjacent"/>
  <disable_collisions link1="robot1_link_5" link2="robot1_link_6" reason="Adjacent"/>
  <disable_collisions link1="robot1_link_4" link2="robot1_link_6" reason="ExpectedContact"/>
  <disable_collisions link1="robot1_link_4" link2="robot1_gripper_base" reason="ExpectedContact"/>
  <disable_collisions link1="robot1_link_5" link2="robot1_gripper_base" reason="Adjacent"/>
  <disable_collisions link1="robot1_link_6" link2="robot1_gripper_base" reason="Adjacent"/>
  <disable_collisions link1="robot1_gripper_base" link2="robot1_left_finger" reason="Adjacent"/>
  <disable_collisions link1="robot1_gripper_base" link2="robot1_right_finger" reason="Adjacent"/>
  <disable_collisions link1="robot1_left_finger" link2="robot1_right_finger" reason="Never"/>
  <disable_collisions link1="robot1_link_6" link2="robot1_left_finger" reason="Adjacent"/>
  <disable_collisions link1="robot1_link_6" link2="robot1_right_finger" reason="Adjacent"/>
  <disable_collisions link1="robot1_link_5" link2="robot1_left_finger" reason="Adjacent"/>
  <disable_collisions link1="robot1_link_5" link2="robot1_right_finger" reason="Adjacent"/>

  <!-- Group states -->
  <group_state name="home" group="robot1_arm">
    <joint name="robot1_rail_joint" value="0.0"/>
    <joint name="robot1_joint_1" value="0"/>
    <joint name="robot1_joint_2" value="0"/>
    <joint name="robot1_joint_3" value="0"/>
    <joint name="robot1_joint_4" value="0"/>
    <joint name="robot1_joint_5" value="0"/>
    <joint name="robot1_joint_6" value="0"/>
  </group_state>

  <group_state name="gripper_open" group="robot1_gripper">
    <joint name="robot1_left_finger_joint" value="0.15"/>
    <joint name="robot1_right_finger_joint" value="0.15"/>
  </group_state>

  <group_state name="gripper_closed" group="robot1_gripper">
    <joint name="robot1_left_finger_joint" value="0.0"/>
    <joint name="robot1_right_finger_joint" value="0.0"/>
  </group_state>

  <!-- End effector -->
  <end_effector name="gripper" parent_link="robot1_tool0" group="robot1_gripper"/>
</robot>
