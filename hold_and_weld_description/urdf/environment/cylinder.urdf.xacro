<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="cylinder_object">
  <xacro:property name="cyl_radius" value="0.225"/>
  <xacro:property name="cyl_height" value="0.25"/>

  <link name="cylinder_link">
    <visual>
      <geometry>
        <cylinder radius="${cyl_radius}" length="${cyl_height}"/>
      </geometry>
      <material name="Grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="${cyl_radius}" length="${cyl_height}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.0128" ixy="0.0" ixz="0.0"
               iyy="0.0128" iyz="0.0"
               izz="0.0253"/>
    </inertial>
  </link>

  <gazebo reference="cylinder_link">
    <visual>
      <material>
        <ambient>1 0 0 1</ambient>
        <diffuse>1 0 0 1</diffuse>
        <specular>0.5 0.5 0.5 1</specular>
      </material>
    </visual>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.8</mu>
            <mu2>0.8</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
  <gravity>0</gravity>
  <static>true</static>
  </gazebo>

</robot>