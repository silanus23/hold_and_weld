<?xml version="1.0"?>
<!-- Elliptic prism with convex/concave half circles, half ellipses and triangles on its long
     sides. Mesh generated by scripts/generate_elliptic_part.py (metres, centred like <cylinder>). -->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="elliptic_part">
  <xacro:property name="mesh" value="package://hold_and_weld_description/meshes/workpieces/elliptic_part.stl"/>

  <link name="elliptic_part_link">
    <visual>
      <geometry>
        <mesh filename="${mesh}"/>
      </geometry>
      <material name="Grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <mesh filename="${mesh}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.0002 0.0079 0.0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01382" ixy="0.0" ixz="0.0"
               iyy="0.02783" iyz="0.0"
               izz="0.03123"/>
    </inertial>
  </link>

  <gazebo reference="elliptic_part_link">
    <visual>
      <material>
        <ambient>1 0 0 1</ambient>
        <diffuse>1 0 0 1</diffuse>
        <specular>0.5 0.5 0.5 1</specular>
      </material>
    </visual>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.8</mu>
            <mu2>0.8</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
  <gravity>0</gravity>
  <static>true</static>
  </gazebo>

</robot>
