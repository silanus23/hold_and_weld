<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="child_link">
  <!--
    Test cube sized for the robotiq_2f_140 gripper (gripper_catalog.xacro): its
    pads close until they touch and open to ~0.1285 m, so 0.10 m leaves
    ~14 mm per side when open. Same link name as cube.urdf.xacro, so it drops
    into the child_link slot of objects.yaml.
  -->
  <xacro:property name="cube_size" value="0.10"/>
  <xacro:property name="cube_mass" value="0.4"/>

  <link name="child_link">
    <visual>
      <geometry>
        <box size="${cube_size} ${cube_size} ${cube_size}"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0.45 0.9 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${cube_size} ${cube_size} ${cube_size}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${cube_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${cube_mass * cube_size**2 / 6}" ixy="0.0" ixz="0.0"
               iyy="${cube_mass * cube_size**2 / 6}" iyz="0.0"
               izz="${cube_mass * cube_size**2 / 6}"/>
    </inertial>
  </link>

  <!-- Gazebo properties for the robotiq cube -->
  <gazebo reference="child_link">
    <visual>
      <material>
        <ambient>0 0.45 0.9 1</ambient>
        <diffuse>0 0.45 0.9 1</diffuse>
        <specular>0.5 0.5 0.5 1</specular>
      </material>
    </visual>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.8</mu>
            <mu2>0.8</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
  <gravity>0</gravity>
  <static>true</static>
  </gazebo>

</robot>
