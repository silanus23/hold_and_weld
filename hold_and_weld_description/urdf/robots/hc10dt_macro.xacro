<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- From Yaskawa-Global/motoman_ros2_support_packages motoman_hc10_support
       (BSD-3-Clause, see vendor/motoman_ros2_support_packages). Upstream has no
       inertials; the ones below are estimates.
       Upstream link_6 has the tool along -Z with the flange 0.170 m out. Here link_6
       is turned 90 deg about Y so the tool is along +X, as on the GP arms: joint_6
       and the link_6 meshes carry that turn, and the flange sits on +X. -->
  <xacro:macro name="motoman_hc10dt" params="prefix">

    <!-- link list -->
    <link name="${prefix}base_link">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/hc10dt/visual/base_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/hc10dt/collision/base_link.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="10.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3"/>
      </inertial>
    </link>
    <link name="${prefix}link_1">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/hc10dt/visual/link_1.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/hc10dt/collision/link_1.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="9.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3"/>
      </inertial>
    </link>
    <link name="${prefix}link_2">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/hc10dt/visual/link_2.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/hc10dt/collision/link_2.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="9.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3"/>
      </inertial>
    </link>
    <link name="${prefix}link_3">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/hc10dt/visual/link_3.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/hc10dt/collision/link_3.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="6.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.15" ixy="0.0" ixz="0.0" iyy="0.15" iyz="0.0" izz="0.15"/>
      </inertial>
    </link>
    <link name="${prefix}link_4">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/hc10dt/visual/link_4.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/hc10dt/collision/link_4.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="4.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
      </inertial>
    </link>
    <link name="${prefix}link_5">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/hc10dt/visual/link_5.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/hc10dt/collision/link_5.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="3.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.03"/>
      </inertial>
    </link>
    <link name="${prefix}link_6">
      <visual>
        <origin xyz="0 0 0" rpy="0 ${radians(-90)} 0"/>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/hc10dt/visual/link_6.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 ${radians(-90)} 0"/>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/hc10dt/collision/link_6.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.005"/>
      </inertial>
    </link>
    <!-- end of link list -->

    <!-- joint list -->
    <joint name="${prefix}joint_1" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link_1"/>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${radians(-180)}" upper="${radians(180)}" effort="368.48" velocity="${radians(130)}"/>
    </joint>
    <joint name="${prefix}joint_2" type="revolute">
      <parent link="${prefix}link_1"/>
      <child link="${prefix}link_2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${radians(-180)}" upper="${radians(180)}" effort="368.48" velocity="${radians(130)}"/>
    </joint>
    <joint name="${prefix}joint_3" type="revolute">
      <parent link="${prefix}link_2"/>
      <child link="${prefix}link_3"/>
      <origin xyz="0 0 0.700" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${radians(-5)}" upper="${radians(355)}" effort="141.12" velocity="${radians(180)}"/>
    </joint>
    <joint name="${prefix}joint_4" type="revolute">
      <parent link="${prefix}link_3"/>
      <child link="${prefix}link_4"/>
      <origin xyz="0 0 -0.500" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${radians(-180)}" upper="${radians(180)}" effort="39.2" velocity="${radians(180)}"/>
    </joint>
    <joint name="${prefix}joint_5" type="revolute">
      <parent link="${prefix}link_4"/>
      <child link="${prefix}link_5"/>
      <origin xyz="0 0.162 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${radians(-180)}" upper="${radians(180)}" effort="31.36" velocity="${radians(250)}"/>
    </joint>
    <joint name="${prefix}joint_6" type="revolute">
      <parent link="${prefix}link_5"/>
      <child link="${prefix}link_6"/>
      <origin xyz="0 0 0" rpy="0 ${radians(90)} 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="${radians(-180)}" upper="${radians(180)}" effort="31.36" velocity="${radians(250)}"/>
    </joint>
    <!-- end of joint list -->

    <link name="${prefix}base"/>
    <joint name="${prefix}base_link-base" type="fixed">
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}base"/>
    </joint>

    <link name="${prefix}flange"/>
    <joint name="${prefix}joint_6-flange" type="fixed">
      <origin xyz="0.170 0 0" rpy="0 0 0"/>
      <parent link="${prefix}link_6"/>
      <child link="${prefix}flange"/>
    </joint>

    <link name="${prefix}tool0"/>
    <joint name="${prefix}flange-tool0" type="fixed">
      <origin xyz="0 0 0" rpy="${radians(180)} ${radians(-90)} 0"/>
      <parent link="${prefix}flange"/>
      <child link="${prefix}tool0"/>
    </joint>

  </xacro:macro>
</robot>
