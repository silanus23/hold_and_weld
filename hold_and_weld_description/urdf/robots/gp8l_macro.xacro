<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- From Yaskawa-Global/motoman_ros2_support_packages motoman_gp8l_support
       (BSD-3-Clause, see vendor/motoman_ros2_support_packages). Upstream has no
       inertials; the ones below are estimates. -->
  <xacro:macro name="motoman_gp8l" params="prefix">

    <!-- link list -->
    <link name="${prefix}base_link">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp8l/visual/base_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp8l/collision/base_link.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="15.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="0.5"/>
      </inertial>
    </link>
    <link name="${prefix}link_1">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp8l/visual/link_1.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp8l/collision/link_1.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="12.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.4" ixy="0.0" ixz="0.0" iyy="0.4" iyz="0.0" izz="0.4"/>
      </inertial>
    </link>
    <link name="${prefix}link_2">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp8l/visual/link_2.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp8l/collision/link_2.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="10.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.4" ixy="0.0" ixz="0.0" iyy="0.4" iyz="0.0" izz="0.4"/>
      </inertial>
    </link>
    <link name="${prefix}link_3">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp8l/visual/link_3.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp8l/collision/link_3.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="8.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.2" ixy="0.0" ixz="0.0" iyy="0.2" iyz="0.0" izz="0.2"/>
      </inertial>
    </link>
    <link name="${prefix}link_4">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp8l/visual/link_4.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp8l/collision/link_4.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="3.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
      </inertial>
    </link>
    <link name="${prefix}link_5">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp8l/visual/link_5.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp8l/collision/link_5.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      </inertial>
    </link>
    <link name="${prefix}link_6">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp8l/visual/link_6.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp8l/collision/link_6.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.005"/>
      </inertial>
    </link>
    <!-- end of link list -->

    <!-- joint list -->
    <joint name="${prefix}joint_1" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link_1"/>
      <origin xyz="0 0 0.450" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${radians(-170)}" upper="${radians(170)}" effort="926.1" velocity="${radians(260)}"/>
    </joint>
    <joint name="${prefix}joint_2" type="revolute">
      <parent link="${prefix}link_1"/>
      <child link="${prefix}link_2"/>
      <origin xyz="0.155 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${radians(-90)}" upper="${radians(155)}" effort="1029" velocity="${radians(230)}"/>
    </joint>
    <joint name="${prefix}joint_3" type="revolute">
      <parent link="${prefix}link_2"/>
      <child link="${prefix}link_3"/>
      <origin xyz="0 0 0.714" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${radians(-85)}" upper="${radians(150)}" effort="551.2" velocity="${radians(260)}"/>
    </joint>
    <joint name="${prefix}joint_4" type="revolute">
      <parent link="${prefix}link_3"/>
      <child link="${prefix}link_4"/>
      <origin xyz="0.740 0 0.200" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="${radians(-200)}" upper="${radians(200)}" effort="89.96" velocity="${radians(470)}"/>
    </joint>
    <joint name="${prefix}joint_5" type="revolute">
      <parent link="${prefix}link_4"/>
      <child link="${prefix}link_5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${radians(-135)}" upper="${radians(135)}" effort="32.68" velocity="${radians(550)}"/>
    </joint>
    <joint name="${prefix}joint_6" type="revolute">
      <parent link="${prefix}link_5"/>
      <child link="${prefix}link_6"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="${radians(-360)}" upper="${radians(360)}" effort="22.54" velocity="${radians(1000)}"/>
    </joint>
    <!-- end of joint list -->

    <link name="${prefix}base"/>
    <joint name="${prefix}base_link-base" type="fixed">
      <origin xyz="0 0 0.450" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}base"/>
    </joint>

    <link name="${prefix}flange"/>
    <joint name="${prefix}joint_6-flange" type="fixed">
      <origin xyz="0.080 0 0" rpy="0 0 0"/>
      <parent link="${prefix}link_6"/>
      <child link="${prefix}flange"/>
    </joint>

    <link name="${prefix}tool0"/>
    <joint name="${prefix}flange-tool0" type="fixed">
      <origin xyz="0 0 0" rpy="${radians(180)} ${radians(-90)} 0"/>
      <parent link="${prefix}flange"/>
      <child link="${prefix}tool0"/>
    </joint>

  </xacro:macro>
</robot>
