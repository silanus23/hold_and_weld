<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="motoman_gp25" params="prefix">

    <!-- link list -->
    <link name="${prefix}base_link">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp25/visual/base_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp25/collision/base_link.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="50.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="5.0" ixy="0.0" ixz="0.0" iyy="5.0" iyz="0.0" izz="5.0"/>
      </inertial>
    </link>
    <link name="${prefix}link_1">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp25/visual/link_1.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp25/collision/link_1.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="30.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="2.0" ixy="0.0" ixz="0.0" iyy="2.0" iyz="0.0" izz="2.0"/>
      </inertial>
    </link>
    <link name="${prefix}link_2">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp25/visual/link_2.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp25/collision/link_2.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="25.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1.5" ixy="0.0" ixz="0.0" iyy="1.5" iyz="0.0" izz="1.5"/>
      </inertial>
    </link>
    <link name="${prefix}link_3">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp25/visual/link_3.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp25/collision/link_3.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="20.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
      </inertial>
    </link>
    <link name="${prefix}link_4">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp25/visual/link_4.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp25/collision/link_4.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="5.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="0.5"/>
      </inertial>
    </link>
    <link name="${prefix}link_5">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp25/visual/link_5.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp25/collision/link_5.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="3.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3"/>
      </inertial>
    </link>
    <link name="${prefix}link_6">
      <visual>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp25/visual/link_6.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hold_and_weld_description/meshes/gp25/collision/link_6.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>
    <!-- end of link list -->

    <!-- joint list -->
    <joint name="${prefix}joint_1" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link_1"/>
      <origin xyz="0 0 0.505" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${radians(-180)}" upper="${radians(180)}" effort="3087" velocity="${radians(210)}"/>
    </joint>
    <joint name="${prefix}joint_2" type="revolute">
      <parent link="${prefix}link_1"/>
      <child link="${prefix}link_2"/>
      <origin xyz="0.150 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${radians(-105)}" upper="${radians(155)}" effort="3087" velocity="${radians(210)}"/>
    </joint>
    <joint name="${prefix}joint_3" type="revolute">
      <parent link="${prefix}link_2"/>
      <child link="${prefix}link_3"/>
      <origin xyz="0 0 0.760" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${radians(-86)}" upper="${radians(160)}" effort="926.1" velocity="${radians(265)}"/>
    </joint>
    <joint name="${prefix}joint_4" type="revolute">
      <parent link="${prefix}link_3"/>
      <child link="${prefix}link_4"/>
      <origin xyz="0.795 0 0.200" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="${radians(-200)}" upper="${radians(200)}" effort="88.2" velocity="${radians(420)}"/>
    </joint>
    <joint name="${prefix}joint_5" type="revolute">
      <parent link="${prefix}link_4"/>
      <child link="${prefix}link_5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${radians(-150)}" upper="${radians(150)}" effort="70.56" velocity="${radians(420)}"/>
    </joint>
    <joint name="${prefix}joint_6" type="revolute">
      <parent link="${prefix}link_5"/>
      <child link="${prefix}link_6"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="${radians(-455)}" upper="${radians(455)}" effort="50.31" velocity="${radians(885)}"/>
    </joint>
    <!-- end of joint list -->

    <link name="${prefix}base"/>
    <joint name="${prefix}base_link-base" type="fixed">
      <origin xyz="0 0 0.505" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}base"/>
    </joint>

    <link name="${prefix}flange"/>
    <joint name="${prefix}joint_6-flange" type="fixed">
      <origin xyz="0.100 0 0" rpy="0 0 0"/>
      <parent link="${prefix}link_6"/>
      <child link="${prefix}flange"/>
    </joint>

    <link name="${prefix}tool0"/>
    <joint name="${prefix}flange-tool0" type="fixed">
      <origin xyz="0 0 0" rpy="${radians(180)} ${radians(-90)} 0"/>
      <parent link="${prefix}flange"/>
      <child link="${prefix}tool0"/>
    </joint>

  </xacro:macro>
</robot>
