<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="dual_robot_system">
  <xacro:arg name="controller_config_file" default=""/>
  <xacro:property name="controller_config_file" value="$(arg controller_config_file)"/>

  <!-- Robot2 initial joint positions (radians). Populated by sim_gazebo.launch.py
       from welding.yaml safety_pose so the welder spawns collision-free. -->
  <xacro:arg name="robot2_initial_pos_j1" default="0"/>
  <xacro:arg name="robot2_initial_pos_j2" default="0"/>
  <xacro:arg name="robot2_initial_pos_j3" default="0"/>
  <xacro:arg name="robot2_initial_pos_j4" default="0"/>
  <xacro:arg name="robot2_initial_pos_j5" default="0"/>
  <xacro:arg name="robot2_initial_pos_j6" default="0"/>

  <!-- Slot models and poses; see config/workcell.yaml -->
  <xacro:arg name="workcell_config" default="$(find hold_and_weld_description)/config/workcell.yaml"/>
  <xacro:property name="workcell" value="${xacro.load_yaml('$(arg workcell_config)')}"/>

  <!-- Include all macro files -->
  <xacro:include filename="$(find hold_and_weld_description)/urdf/extra_axis/linear_rail_prefix.xacro"/>
  <xacro:include filename="$(find hold_and_weld_description)/urdf/robots/robot_catalog.xacro"/>
  <xacro:include filename="$(find hold_and_weld_description)/urdf/end_effectors/gripper_catalog.xacro"/>
  <xacro:include filename="$(find hold_and_weld_description)/urdf/end_effectors/welding_torch_prefix.xacro"/>

  <link name="world"/>

  <!-- Robot 1: Gripper System with Rail -->
  <xacro:property name="robot1" value="${workcell['robots']['robot1']}"/>
  <xacro:linear_rail_macro parent="world" prefix="robot1_"
    x="${robot1['x']}" y="${robot1['y']}" z="${robot1['z']}" yaw="${robot1['yaw']}"/>
  <xacro:robot_arm_macro model="${robot1['model']}" parent="robot1_rail_carriage" prefix="robot1_"
    controller_config_file="${controller_config_file}"/>
  <xacro:gripper_catalog_macro model="${workcell.get('gripper_model', '')}" prefix="robot1_" parent="robot1_tool0"/>

  <!-- Robot 2: Welder System (standalone) -->
  <xacro:property name="robot2" value="${workcell['robots']['robot2']}"/>
  <xacro:robot_arm_macro model="${robot2['model']}" parent="world" prefix="robot2_"
    x="${robot2['x']}" y="${robot2['y']}" z="${robot2['z']}" yaw="${robot2['yaw']}"
    initial_pos_j1="$(arg robot2_initial_pos_j1)"
    initial_pos_j2="$(arg robot2_initial_pos_j2)"
    initial_pos_j3="$(arg robot2_initial_pos_j3)"
    initial_pos_j4="$(arg robot2_initial_pos_j4)"
    initial_pos_j5="$(arg robot2_initial_pos_j5)"
    initial_pos_j6="$(arg robot2_initial_pos_j6)"
    controller_config_file="${controller_config_file}"/>
  <xacro:welding_torch_macro prefix="robot2_"/>

  <joint name="robot2_tool0_to_torch" type="fixed">
    <parent link="robot2_tool0"/>
    <child link="robot2_torch_mount"/>
    <origin xyz="0 0 0" rpy="3.14 0 0"/>
  </joint>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>${controller_config_file}</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
  </gazebo>
</robot>
